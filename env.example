# =============================================================================
# Learning the Levers - Environment Variables
# Copy this file to .env and fill in your actual credentials.
# =============================================================================

# Evomi Residential Proxy (Swiss IPs)
PROXY_HOST=rp.evomi.com
PROXY_PORT=1000
PROXY_USER=your_evomi_username
PROXY_PASS=your_evomi_password

# Telegram Alerting (Task 41)
# 1. Message @BotFather on Telegram -> /newbot -> copy the token
# 2. Send any message to your new bot
# 3. Visit: https://api.telegram.org/bot<TOKEN>/getUpdates -> copy chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ChromeDriver (override if not at default /usr/bin/chromedriver)
# CHROMEDRIVER_PATH=/usr/bin/chromedriver

# Data directory (mounted disk on VM; override for local dev)
# DATA_DIR=/data

# Cookie batch subdirectory (date-stamped folder under 01_config/cookies/)
# Update this when you re-export cookies.
# COOKIE_BATCH=260306

# Browser configuration
# Update USER_AGENT to match current stable Chrome before starting collection.
# USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/145.0.7632.109 Safari/537.36
# HEADLESS=true

# Scraping timing (seconds) — tune for VM performance / proxy latency
# PAGE_LOAD_TIMEOUT=30
# RENDER_WAIT=5
# SCROLL_WAIT=3
# JITTER_MIN=20
# JITTER_MAX=40
# MAX_RETRIES=2

# Logging
LOG_LEVEL=INFO
